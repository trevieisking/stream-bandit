{
  "schema": "stream-bandit-tcg-card-visual-printing-v1.2",
  "recorded_at": "2026-09-17",
  "purpose": "Self-contained visual/printing contract aligned to the approved prototype/showcase hierarchy while remaining faithful to structured gameplay data. V1.2 restores the explicit ordinary-Creature HP-top-left rule without inventing a generic play/evolution Cost.",
  "supersedes": "tcg-card-visual-printing-v1.1.json",
  "visual_authority": {
    "approved_showcase_decks": [
      "Ember/Ashrush",
      "Tide/Deep Current",
      "Grove/Wildgrowth",
      "Volt/Live Wire",
      "Stone/Unbroken",
      "Gale/Skyshift",
      "Shade/Nightbind",
      "Astral/Second Sky",
      "Fairy/Glimmerwish",
      "Underworld/Grave Pact"
    ],
    "original_playable_prototype_interaction_authority": true,
    "artwork_on_every_printable_card": true,
    "concept_art_is_rules_authority": false,
    "structured_card_data_is_rules_authority": true
  },
  "creature_card": {
    "header": {
      "top_left": "HP + value",
      "top_right": "Creature type / element badge",
      "identity_band": [
        "card_name",
        "stage_or_classification"
      ],
      "hp_must_be_clearly_labelled": true,
      "current_ordinary_creature_generic_play_or_evolution_cost_exists": false,
      "invent_visual_cost_when_not_defined": false,
      "future_schema_defined_cost_rule": "If a future/current card family explicitly defines a real Cost property, render that Cost in a separately defined family-specific location; do not displace ordinary Creature HP merely to imitate concept art."
    },
    "art": "large dedicated card-specific artwork window below the upper header",
    "action_slot_count": 2,
    "legal_action_slot_shapes": [
      ["Ability", "Attack 1"],
      ["Attack 1", "Attack 2"]
    ],
    "forbidden_action_slot_shape": ["Ability", "Attack 1", "Attack 2"],
    "attack_fields": [
      "Attack label",
      "Attack name",
      "Attack Cost label + Essence icons/types/count",
      "Damage label + value",
      "rules/effect text"
    ],
    "footer": [
      "Withdraw Cost + value at bottom-right",
      "rarity marker",
      "printing finish marker",
      "set/pack marker"
    ]
  },
  "numeric_label_policy": {
    "rule": "Every visible gameplay number must have a named property or globally standardized labelled icon with accessible text. Never add a number simply to fill a visual badge.",
    "required_examples": [
      "HP 150",
      "Attack Cost 2 Ember",
      "Damage 60",
      "Withdraw Cost 2",
      "Shield 40",
      "Heal 20"
    ],
    "conditional_example": "Cost 3 only when a structured card family/property actually defines Cost 3",
    "floating_unlabelled_numbers_allowed": false
  },
  "other_card_families": {
    "Tactic": [
      "Cost when schema-defined",
      "type",
      "name",
      "large art",
      "effect text",
      "rarity",
      "finish",
      "set marker"
    ],
    "Essence": [
      "Essence type",
      "amount or special identity",
      "large art",
      "effect text if special",
      "rarity",
      "finish",
      "set marker"
    ],
    "Relic": [
      "Cost when schema-defined",
      "type",
      "name",
      "large art",
      "attachment/effect text",
      "rarity",
      "finish",
      "set marker"
    ],
    "Realm": [
      "Cost when schema-defined",
      "type",
      "name",
      "large environment art",
      "persistent/replace text",
      "rarity",
      "finish",
      "set marker"
    ]
  },
