{
  "version": "5",
  "authority": "Stream Bandit TCG canonical art manifest",
  "hosting": "repository-relative assets; GitHub Pages and IONOS compatible; no GitHack dependency",
  "policy": {
    "preserve_original_bytes": true,
    "ui_reference_rule": "Full-screen UI compositions are locked visual references for rebuilding interactive DOM/CSS. They are not flattened interactive runtime screens.",
    "launch_elements": [
      "astral",
      "ember",
      "gale",
      "grove",
      "shade",
      "stone",
      "tide",
      "volt"
    ],
    "future_concepts": [
      "fairy",
      "underworld"
    ],
    "runtime_background_rule": "Only clean background masters may be used as runtime CSS backgrounds. Full-screen UI reference compositions remain visual authority only and must never be flattened behind live controls.",
    "printing_identity_rule": "Gameplay resolves by card_id; collectible ownership/pulls resolve by printing_id; exact media resolves by artwork_id.",
    "variant_rule": "Rarity, foil/finish and alternate artwork may create multiple collectible printings of the same gameplay card without changing its rules.",
    "accessory_identity_rule": "Official deck products own a themed sleeve/card-back set, cosmetic battle coin and deck box. accessory_id is collectible identity; artwork_id is exact media identity. Accessories never alter gameplay."
  },
