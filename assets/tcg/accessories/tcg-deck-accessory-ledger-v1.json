    "current_artworks_missing": 24
  },
  "accessory_types": [
    {
      "id": "sleeve_set",
      "label": "Card Sleeve Set",
      "purpose": "Defines the visible back/sleeve treatment for cards.",
      "gameplay_effect": false
    },
    {
      "id": "battle_coin",
      "label": "Battle Coin",
      "purpose": "Deck-themed visual coin for coin/toss presentation where shown.",
      "gameplay_effect": false,
      "randomness_effect": false
    },
    {
      "id": "deck_box",
      "label": "Deck Box",
      "purpose": "Deck/collection/shop cosmetic container presentation.",
      "gameplay_effect": false
    }
  ],
  "ownership_policy": {
    "official_starter_deck_includes_matching_sleeve_set": true,
    "official_starter_deck_includes_matching_battle_coin": true,
    "official_starter_deck_includes_matching_deck_box": true,
    "grant_is_idempotent": true,
    "existing_starter_owners_require_owner_safe_backfill": true,
    "custom_user_built_deck_creates_new_accessory_identity": false,
    "custom_user_built_deck_uses_owned_accessories": true,
    "duplicate_shop_purchase_of_owned_accessory": false,
    "unowned_accessory_shop_availability_required": true,
    "full_theme_accessory_bundle_may_also_be_listed": true,
    "prices_and_currency_require_canonical_economy_owner": true
  },
  "safety_policy": {
    "battle_coin_never_affects_server_randomness": true,
    "sleeve_never_reveals_hidden_card_identity": true,
    "deck_box_never_changes_deck_legality_or_capacity": true,
    "accessory_ownership_never_changes_gameplay_rules": true
  },
  "shop_contract": {
    "required_categories": [
      "Card Sleeves",
      "Battle Coins",
      "Deck Boxes",
      "Accessory Bundles"
    ],
    "catalog_identity": "accessory_id",
    "artwork_identity": "artwork_id",
    "owned_items_must_be_recognized": true,
    "fake_browser_prices_forbidden": true,
    "purchase_grants_require_canonical_economy_owner": true
  },
  "future_starter_rule": {
    "every_future_official_starter_or_deck_product_must_define_same_three_accessory_types": true,
    "examples_when_promoted": [
      "Fairy / Glimmerwish",
      "Underworld / Grave Pact"
    ],
    "note": "Future concepts do not become launch/runtime products merely because the accessory rule is reserved for them."
  },
